{
  // 1) ワークスペースの仮想環境（venv）を明示
  "python.defaultInterpreterPath": "${workspaceFolder}/envs/bin/python",

  // 2) 新しい Environments 拡張を使い、ターミナルで自動アクティベート
  "python.useEnvsExtension": true,
  "python-envs.terminal.autoActivationType": "command", // or "shellStartup"

  // 3) 環境マネージャは venv / パッケージマネージャは pip を優先
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.defaultPackageManager": "ms-python.python:pip",

  // 4) Code Runner でも venv の Python を直指定（安定）
  "code-runner.runInTerminal": true,
  "code-runner.executorMap": {
    "python": "\"${workspaceFolder}/envs/bin/python\" -u"
  }
}
